{
  "expo": {
    "name": "UniBlueprint",
    "slug": "uniblueprint",
    "scheme": "uniblueprint",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#F5F0E8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.uniblueprint.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "UniBlueprint needs access to your photo library so you can choose a profile picture or an image for an ad post.",
        "NSCameraUsageDescription": "UniBlueprint needs camera access so you can take a photo to use as your profile picture or ad image."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8"
      },
      "package": "com.uniblueprint.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "69a062e2-f045-44c6-aeed-81e557ab3575"
      }
    },
    "owner": "uniblueprint",
    "privacy": "unlisted"
  }
}
